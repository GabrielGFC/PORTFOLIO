{
  "name": "web-portfolio",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "type": "module",
  "homepage": "https://gabrielgfc.github.io/PORTFOLIO/",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "bun run build",
    "deploy": "gh-pages -d dist",
    "pack": "bun pm pack --destination dist"
  },
  "overrides": {
    "ajv@<6.14.0": "^6.14.0",
    "browserslist": "^4.29.5",
    "brace-expansion@<1.1.17": "^1.1.22",
    "brace-expansion@>=2.0.0 <2.1.6": "^2.1.8",
    "nanoid@<3.3.16": "^3.3.20",
    "postcss@<=8.5.11": "^8.5.32",
    "source-map-js@<1.2.2": "^1.2.2",
    "minimatch@<3.1.3": "^3.1.5",
    "minimatch@>=9.0.0 <9.0.7": "^9.0.9",
    "flatted@<3.4.0": "^3.4.4",
    "rollup@<4.59.0": "^4.68.3",
    "picomatch@<2.3.2": "^2.3.2",
    "picomatch@>=4.0.0 <4.0.4": "^4.0.7",
    "js-yaml@<4.3.0": "^4.3.2"
  },
  "dependencies": {
    "framer-motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "8.57.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "jiti": "^2.7.0",
    "sass": "^1.108.2",
    "sass-embedded": "^1.108.2",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-image-optimizer": "^2.0.3"
  }
}
