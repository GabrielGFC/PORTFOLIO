{
  "name": "web-portfolio",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.1.34",
  "type": "module",
  "homepage": "https://gabrielgfc.github.io/PORTFOLIO/",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "bun run build",
    "deploy": "gh-pages -d dist",
    "pack": "bun pm pack --destination dist"
  },
  "dependencies": {
    "framer-motion": "^12.23.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@eslint/js": "8.57.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.15.18",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "8.57.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "gh-pages": "^6.3.0",
    "globals": "^15.14.0",
    "jiti": "^2.4.2",
    "sass": "^1.88.0",
    "sass-embedded": "^1.88.0",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.5",
    "vite-plugin-image-optimizer": "^2.0.3"
  }
}
